# Copy to .env.local for local development. Never commit real values.
# See ENVIRONMENT.md for what each variable is for and how it's used.

# --- Supabase -----------------------------------------------------------
# From your Supabase project settings (or `supabase start` for local dev).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=ZAR

# --- Payment providers ------------------------------------------------------
# Bambini never hard-codes a single payment provider (see ARCHITECTURE.md).
# Set PAYMENT_PROVIDER to select the active adapter; "mock" needs no keys
# and is the default for local development. Also set
# payment_providers.is_active = true for the matching row (and false for
# the others) in the database — the two must be changed together, see
# DECISIONS.md.
PAYMENT_PROVIDER=mock
# Required only once PAYMENT_PROVIDER=payfast. Get these from your
# PayFast (sandbox or live) account's Settings page — never commit real
# values. PAYFAST_SANDBOX defaults to true (safer default: a missing/
# misconfigured environment fails toward "test mode," not real charges);
# set it to "false" explicitly to use the live PayFast host.
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# PAYFAST_SANDBOX=true
# YOCO_SECRET_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Delivery providers -----------------------------------------------------
# Set DELIVERY_PROVIDERS to a comma-separated list of active adapters.
# "mock" needs no keys and is the default for local development.
DELIVERY_PROVIDERS=mock
# UBER_DIRECT_CUSTOMER_ID=
# UBER_DIRECT_CLIENT_ID=
# UBER_DIRECT_CLIENT_SECRET=
# COURIER_GUY_API_KEY=
# BOB_GO_API_KEY=

# --- Observability (optional) -----------------------------------------------
# Server-only. A DSN is not itself a secret (it can't be used to read
# your account, only to submit events), but never prefix it with
# NEXT_PUBLIC_ regardless — Sentry is wired up server-side only (see
# src/instrumentation.ts). Leaving this unset is a fully supported,
# fully local-dev-friendly state: Sentry.init() is simply never called,
# and reportOperationalFailure() (src/lib/monitoring) no-ops.
# SENTRY_DSN=

# --- Phone verification (Phase 15A.1) ---------------------------------------
# Server-only. Leave unset/false until the Supabase Send SMS hook has been
# connected to SMSMessenger and tested (see DEPLOYMENT.md "Connecting SMS").
# Only the exact value "true" turns it on. It gates the UI, the server actions
# AND the hook endpoint itself (direct Auth API calls bypass the actions) —
# but it never marks anyone verified and never relaxes can_transact(), which
# still needs auth.users.phone_confirmed_at. There is deliberately no bypass.
# PHONE_VERIFICATION_ENABLED=false

# --- SMS hook + provider (Phase 15A.3) --------------------------------------
# ALL server-only, ALL secret except the flags. NEVER prefix with
# NEXT_PUBLIC_, never commit real values, never log them. These feed the
# Supabase "Send SMS" hook endpoint (src/app/api/hooks/send-sms/route.ts),
# which forwards the code Supabase Auth generated to SMSMessenger.
# Supabase Dashboard -> Authentication -> Hooks -> Send SMS generates this
# ("v1,whsec_<base64>"); it authenticates Supabase's calls to the endpoint:
# SEND_SMS_HOOK_SECRET=
# SMSMessenger REST credentials (account email + API token):
# SMSMESSENGER_EMAIL=
# SMSMESSENGER_API_TOKEN=
# Random value (16+ chars) keying the HMAC that hashes destination numbers
# into throttle subjects (generate with: openssl rand -base64 32):
# PHONE_THROTTLE_HASH_SECRET=
# Optional emergency spend ceiling: OTP SMS per hour across ALL users
# (default 200, allowed 1-100000):
# PHONE_GLOBAL_SMS_HOURLY_LIMIT=200
