# Copy to .env.local for local development. Never commit real values.
# See ENVIRONMENT.md for what each variable is for and how it's used.

# --- Supabase -----------------------------------------------------------
# From your Supabase project settings (or `supabase start` for local dev).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=ZAR

# --- Payment providers ------------------------------------------------------
# Bambini never hard-codes a single payment provider (see ARCHITECTURE.md).
# Set PAYMENT_PROVIDER to select the active adapter; "mock" needs no keys
# and is the default for local development.
PAYMENT_PROVIDER=mock
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# YOCO_SECRET_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Delivery providers -----------------------------------------------------
# Set DELIVERY_PROVIDERS to a comma-separated list of active adapters.
# "mock" needs no keys and is the default for local development.
DELIVERY_PROVIDERS=mock
# UBER_DIRECT_CUSTOMER_ID=
# UBER_DIRECT_CLIENT_ID=
# UBER_DIRECT_CLIENT_SECRET=
# COURIER_GUY_API_KEY=
# BOB_GO_API_KEY=

# --- Observability (optional) -----------------------------------------------
# SENTRY_DSN=
